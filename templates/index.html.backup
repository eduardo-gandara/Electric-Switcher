<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
    <title>⚡ Electric Switcher - Electricity Tariff Simulator</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary: #2563eb;
            --primary-dark: #1e40af;
            --success: #10b981;
            --warning: #f59e0b;
            --danger: #ef4444;
            --gray-50: #f9fafb;
            --gray-100: #f3f4f6;
            --gray-200: #e5e7eb;
            --gray-400: #9ca3af;
            --gray-700: #374151;
            --gray-900: #111827;
        }

        html, body {
            height: 100%;
            width: 100%;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 10px;
            color: var(--gray-900);
            overflow-x: hidden;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            width: 100%;
        }

        header {
            background: white;
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 20px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            text-align: center;
        }

        header h1 {
            font-size: clamp(1.5em, 5vw, 2.5em);
            color: var(--primary);
            margin-bottom: 8px;
        }

        header p {
            color: var(--gray-700);
            font-size: clamp(0.9em, 3vw, 1.1em);
        }

        header .subtitle {
            font-size: clamp(0.8em, 2.5vw, 0.9em);
            color: var(--gray-700);
            margin-top: 8px;
        }

        .main-grid {
            display: grid;
            grid-template-columns: 1fr 2fr;
            gap: 20px;
            margin-bottom: 20px;
        }

        .card {
            background: white;
            border-radius: 12px;
            padding: 20px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        .card h2 {
            color: var(--primary);
            margin-bottom: 20px;
            font-size: clamp(1.2em, 4vw, 1.5em);
            border-bottom: 2px solid var(--gray-100);
            padding-bottom: 10px;
        }

        .form-group {
            margin-bottom: 15px;
        }

        label {
            display: block;
            margin-bottom: 6px;
            font-weight: 600;
            color: var(--gray-700);
            font-size: clamp(0.85em, 2vw, 1em);
        }

        input[type="file"],
        input[type="date"],
        select {
            width: 100%;
            padding: 10px;
            border: 2px solid var(--gray-200);
            border-radius: 8px;
            font-size: clamp(0.9em, 2vw, 1em);
            transition: border-color 0.3s;
            font-family: inherit;
        }

        input[type="file"]:hover,
        input[type="date"]:hover,
        select:hover {
            border-color: var(--primary);
        }

        input[type="file"]:focus,
        input[type="date"]:focus,
        select:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
        }

        .checkbox-group {
            display: flex;
            flex-direction: column;
            gap: 8px;
            margin-top: 10px;
        }

        .checkbox-item {
            display: flex;
            align-items: flex-start;
            padding: 10px;
            background: var(--gray-50);
            border-radius: 8px;
            cursor: pointer;
            transition: background 0.2s;
        }

        .checkbox-item:hover {
            background: var(--gray-100);
        }

        .checkbox-item input[type="checkbox"],
        .checkbox-item input[type="radio"] {
            width: 18px;
            height: 18px;
            margin-right: 10px;
            margin-top: 2px;
            cursor: pointer;
            flex-shrink: 0;
        }

        .checkbox-item label {
            margin: 0;
            font-weight: normal;
            cursor: pointer;
            flex: 1;
        }

        .checkbox-item small {
            display: block;
            font-size: 0.85em;
            color: var(--gray-700);
            margin-top: 2px;
        }

        button {
            background: var(--primary);
            color: white;
            border: none;
            padding: 12px 20px;
            border-radius: 8px;
            font-size: clamp(0.9em, 2vw, 1em);
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            width: 100%;
            font-family: inherit;
        }

        button:hover:not(:disabled) {
            background: var(--primary-dark);
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
        }

        button:active:not(:disabled) {
            transform: translateY(0);
        }

        button:disabled {
            background: var(--gray-400);
            cursor: not-allowed;
            transform: none;
        }

        .btn-secondary {
            background: var(--success);
            margin-top: 10px;
        }

        .btn-secondary:hover:not(:disabled) {
            background: #059669;
        }

        .file-input-label {
            display: block;
            padding: 12px;
            background: var(--gray-100);
            border: 2px dashed var(--primary);
            border-radius: 8px;
            cursor: pointer;
            text-align: center;
            color: var(--primary);
            font-weight: 600;
            width: 100%;
            transition: all 0.2s;
            font-size: clamp(0.85em, 2vw, 1em);
        }

        .file-input-label:hover {
            background: var(--primary);
            color: white;
        }

        #fileInput {
            display: none;
        }

        .status {
            padding: 12px;
            border-radius: 8px;
            margin-top: 12px;
            font-weight: 500;
            font-size: clamp(0.85em, 2vw, 0.95em);
        }

        .status.success {
            background: #d1fae5;
            color: #047857;
            border-left: 4px solid var(--success);
        }

        .status.error {
            background: #fee2e2;
            color: #dc2626;
            border-left: 4px solid var(--danger);
        }

        .status.info {
            background: #dbeafe;
            color: #0284c7;
            border-left: 4px solid var(--primary);
        }

        .spinner {
            display: inline-block;
            width: 16px;
            height: 16px;
            border: 3px solid rgba(255, 255, 255, 0.3);
            border-radius: 50%;
            border-top-color: white;
            animation: spin 1s linear infinite;
            margin-right: 8px;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        .results {
            display: none;
        }

        .results.show {
            display: block;
        }

        .ranking {
            margin-bottom: 20px;
        }

        .rank-item {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 12px;
            position: relative;
        }

        .rank-item.rank-1 {
            border-left: 5px solid #fbbf24;
            box-shadow: 0 8px 16px rgba(251, 191, 36, 0.2);
        }

        .rank-item.rank-2 {
            border-left: 5px solid #a0a0a0;
        }

        .rank-item.rank-3 {
            border-left: 5px solid #d4883d;
        }

        .rank-number {
            position: absolute;
            top: 10px;
            right: 10px;
            background: rgba(255, 255, 255, 0.3);
            width: 36px;
            height: 36px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2em;
            font-weight: bold;
        }

        .rank-item h3 {
            margin-bottom: 4px;
            font-size: clamp(1em, 3vw, 1.3em);
        }

        .rank-item p {
            margin: 4px 0;
            opacity: 0.95;
            font-size: clamp(0.85em, 2.5vw, 1em);
        }

        .cost {
            font-size: clamp(1.5em, 4vw, 2em);
            font-weight: bold;
            margin: 10px 0;
        }

        .savings {
            background: rgba(16, 185, 129, 0.2);
            padding: 8px;
            border-radius: 6px;
            margin-top: 8px;
            color: #d1fae5;
            font-size: clamp(0.85em, 2vw, 0.95em);
        }

        .metrics {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 15px;
            margin-bottom: 20px;
        }

        .metric {
            background: var(--gray-50);
            padding: 15px;
            border-radius: 8px;
            text-align: center;
        }

        .metric-value {
            font-size: clamp(1.3em, 5vw, 2em);
            font-weight: bold;
            color: var(--primary);
        }

        .metric-label {
            color: var(--gray-700);
            margin-top: 5px;
            font-size: clamp(0.75em, 2vw, 0.9em);
        }

        .risks {
            background: #fef3c7;
            border-left: 4px solid var(--warning);
            padding: 12px;
            border-radius: 8px;
            margin: 15px 0;
        }

        .risks h3 {
            color: #d97706;
            margin-bottom: 8px;
            font-size: clamp(1em, 3vw, 1.2em);
        }

        .risk-item {
            margin: 8px 0;
            padding-left: 15px;
            border-left: 2px solid var(--warning);
            color: var(--gray-700);
            font-size: clamp(0.85em, 2vw, 0.95em);
        }

        .recommendations {
            background: #dbeafe;
            border-left: 4px solid var(--primary);
            padding: 12px;
            border-radius: 8px;
        }

        .recommendations h3 {
            color: var(--primary);
            margin-bottom: 8px;
            font-size: clamp(1em, 3vw, 1.2em);
        }

        .rec-item {
            margin: 8px 0;
            padding-left: 15px;
            border-left: 2px solid var(--primary);
            color: var(--gray-700);
            font-size: clamp(0.85em, 2vw, 0.95em);
        }

        .tab-buttons {
            display: flex;
            gap: 8px;
            margin-bottom: 15px;
            border-bottom: 2px solid var(--gray-200);
            overflow-x: auto;
            flex-wrap: wrap;
        }

        .tab-button {
            background: none;
            border: none;
            padding: 10px 15px;
            font-weight: 600;
            color: var(--gray-700);
            cursor: pointer;
            border-bottom: 3px solid transparent;
            transition: all 0.3s;
            width: auto;
            font-size: clamp(0.8em, 2vw, 0.95em);
            white-space: nowrap;
        }

        .tab-button.active {
            color: var(--primary);
            border-bottom-color: var(--primary);
        }

        .tab-content {
            display: none;
        }

        .tab-content.active {
            display: block;
        }

        .no-data {
            text-align: center;
            padding: 30px;
            color: var(--gray-700);
            font-size: clamp(0.9em, 2vw, 1em);
        }

        @media (max-width: 1024px) {
            .main-grid {
                grid-template-columns: 1fr;
                gap: 15px;
            }

            .card {
                padding: 15px;
            }

            header {
                padding: 15px;
            }
        }

        @media (max-width: 640px) {
            body {
                padding: 8px;
            }

            .main-grid {
                grid-template-columns: 1fr;
                gap: 12px;
            }

            .card {
                padding: 12px;
            }

            header {
                padding: 12px;
                margin-bottom: 12px;
            }

            header h1 {
                margin-bottom: 5px;
            }

            .metrics {
                grid-template-columns: repeat(2, 1fr);
            }

            .tab-buttons {
                gap: 4px;
            }

            .tab-button {
                padding: 8px 10px;
            }

            .rank-item {
                padding: 12px;
            }

            .rank-number {
                width: 32px;
                height: 32px;
                font-size: 1em;
            }

            input[type="file"],
            input[type="date"],
            select,
            button {
                padding: 10px;
                font-size: 16px;
            }
        }

        @media (max-width: 480px) {
            .metrics {
                grid-template-columns: 1fr;
            }

            .main-grid {
                gap: 10px;
            }

            .card {
                padding: 10px;
            }

            .form-group {
                margin-bottom: 12px;
            }

            .checkbox-item {
                padding: 8px;
            }

            .status {
                padding: 10px;
                margin-top: 10px;
            }
        }

        .section-title {
            font-weight: 600;
            color: var(--gray-900);
            margin-bottom: 8px;
            font-size: clamp(0.9em, 2vw, 1em);
        }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1>⚡ Electric Switcher</h1>
            <p>Electricity Tariff Simulator for Ireland</p>
            <p class="subtitle">
                Calculate how much you'd pay with each tariff and decide if you should switch providers
            </p>
        </header>

        <div class="main-grid">
            <!-- Left Panel: Configuration -->
            <div class="card">
                <h2>📋 Configuration</h2>

                <!-- Input Mode -->
                <div class="form-group">
                    <label class="section-title">Input Mode:</label>
                    <div class="checkbox-group">
                        <div class="checkbox-item">
                            <input type="radio" id="modeDemo" name="mode" value="demo" checked>
                            <label for="modeDemo">📊 Demo (example data)</label>
                        </div>
                        <div class="checkbox-item">
                            <input type="radio" id="modeReal" name="mode" value="real">
                            <label for="modeReal">📁 My Data (CSV from ESB)</label>
                        </div>
                    </div>
                </div>

                <!-- CSV Section (hidden initially) -->
                <div id="csvSection" style="display: none;">
                    <div class="form-group">
                        <label>Upload consumption CSV:</label>
                        <label for="fileInput" class="file-input-label">
                            📤 Select your CSV file
                        </label>
                        <input type="file" id="fileInput" accept=".csv">
                        <div id="fileStatus"></div>
                    </div>
                </div>

                <!-- Select Tariffs -->
                <div class="form-group">
                    <label class="section-title">Select tariffs to compare:</label>
                    <div id="tariffsContainer" class="checkbox-group">
                        <p style="text-align: center; color: var(--gray-700); font-size: 0.9em;">Loading tariffs...</p>
                    </div>
                </div>

                <!-- Dates -->
                <div class="form-group">
                    <label for="startMonth">Start date:</label>
                    <input type="date" id="startMonth" value="2026-06-01">
                </div>

                <div class="form-group">
                    <label for="endMonth">End date:</label>
                    <input type="date" id="endMonth" value="2026-09-30">
                </div>

                <!-- Buttons -->
                <button id="simulateBtn" class="btn-secondary">
                    ⚡ Run Simulation
                </button>

                <button id="resetBtn" style="background: #6b7280; margin-top: 10px;">
                    🔄 Clear
                </button>
            </div>

            <!-- Right Panel: Results -->
            <div class="card results" id="resultsCard">
                <div class="tab-buttons">
                    <button class="tab-button active" data-tab="ranking">📊 Ranking</button>
                    <button class="tab-button" data-tab="analysis">📈 Analysis</button>
                    <button class="tab-button" data-tab="details">ℹ️ Details</button>
                </div>

                <!-- Tab: Ranking -->
                <div id="rankingTab" class="tab-content active">
                    <div id="rankingContent" class="no-data">
                        Run the simulation to see the tariff ranking
                    </div>
                </div>

                <!-- Tab: Analysis -->
                <div id="analysisTab" class="tab-content">
                    <div id="analysisContent" class="no-data">
                        Analysis data will appear here
                    </div>
                </div>

                <!-- Tab: Details -->
                <div id="detailsTab" class="tab-content">
                    <div id="detailsContent" class="no-data">
                        Technical details will appear here
                    </div>
                </div>
            </div>
        </div>

        <!-- Metrics Section (appears after simulation) -->
        <div id="metricsSection" style="display: none;">
            <div class="metrics">
                <div class="metric">
                    <div class="metric-value" id="metricConsumption">-</div>
                    <div class="metric-label">Total Consumption (kWh)</div>
                </div>
                <div class="metric">
                    <div class="metric-value" id="metricMonths">-</div>
                    <div class="metric-label">Period (months)</div>
                </div>
                <div class="metric">
                    <div class="metric-value" id="metricBestCost">-</div>
                    <div class="metric-label">Best Tariff (€/year)</div>
                </div>
                <div class="metric">
                    <div class="metric-value" id="metricSavings">-</div>
                    <div class="metric-label">Maximum Savings (€)</div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Global State
        const state = {
            mode: 'demo',
            uploadedFile: null,
            tariffs: [],
            selectedTariffs: [],
            results: null
        };

        // Load tariffs on startup
        loadTariffs();

        // Event Listeners
        document.getElementById('modeDemo').addEventListener('change', () => {
            state.mode = 'demo';
            document.getElementById('csvSection').style.display = 'none';
        });

        document.getElementById('modeReal').addEventListener('change', () => {
            state.mode = 'real';
            document.getElementById('csvSection').style.display = 'block';
        });

        document.getElementById('fileInput').addEventListener('change', uploadCSV);
        document.getElementById('simulateBtn').addEventListener('click', runSimulation);
        document.getElementById('resetBtn').addEventListener('click', reset);

        // Tab switching
        document.querySelectorAll('.tab-button').forEach(btn => {
            btn.addEventListener('click', (e) => {
                const tabName = e.target.dataset.tab;
                switchTab(tabName);
            });
        });

        // Functions
        async function loadTariffs() {
            try {
                const response = await fetch('/api/tariffs');
                const data = await response.json();

                if (data.success) {
                    state.tariffs = data.tariffs;
                    renderTariffs();
                }
            } catch (error) {
                console.error('Error loading tariffs:', error);
                showError('Error loading tariffs', 'tariffsContainer');
            }
        }

        function renderTariffs() {
            const container = document.getElementById('tariffsContainer');
            container.innerHTML = '';

            state.tariffs.forEach((tariff, index) => {
                const id = `tariff-${index}`;
                const item = document.createElement('div');
                item.className = 'checkbox-item';

                const checked = index < 2 ? 'checked' : '';

                item.innerHTML = `
                    <input type="checkbox" id="${id}" value="${index}" ${checked}>
                    <label for="${id}">
                        <strong>${tariff.supplier}</strong><br>
                        <small>${tariff.plan_name}</small>
                    </label>
                `;

                container.appendChild(item);

                if (checked) {
                    state.selectedTariffs.push(index);
                }

                item.querySelector('input').addEventListener('change', (e) => {
                    if (e.target.checked) {
                        if (!state.selectedTariffs.includes(index)) {
                            state.selectedTariffs.push(index);
                        }
                    } else {
                        state.selectedTariffs = state.selectedTariffs.filter(i => i !== index);
                    }
                });
            });
        }

        async function uploadCSV() {
            const file = document.getElementById('fileInput').files[0];
            if (!file) return;

            const formData = new FormData();
            formData.append('file', file);

            const statusDiv = document.getElementById('fileStatus');
            statusDiv.innerHTML = '<div class="status info"><span class="spinner"></span>Processing CSV...</div>';

            try {
                const response = await fetch('/api/upload-csv', {
                    method: 'POST',
                    body: formData
                });

                const data = await response.json();

                if (data.success) {
                    state.uploadedFile = data.filename;
                    statusDiv.innerHTML = `<div class="status success">✓ ${data.message}</div>`;
                } else {
                    statusDiv.innerHTML = `<div class="status error">✗ ${data.error}</div>`;
                }
            } catch (error) {
                statusDiv.innerHTML = `<div class="status error">✗ Error: ${error.message}</div>`;
            }
        }

        async function runSimulation() {
            if (state.selectedTariffs.length === 0) {
                alert('Select at least one tariff');
                return;
            }

            const btn = document.getElementById('simulateBtn');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner"></span>Running...';

            try {
                const selectedTariffs = state.selectedTariffs.map(i => state.tariffs[i]);

                const payload = {
                    tariffs: selectedTariffs,
                    start_month: document.getElementById('startMonth').value.substring(0, 7),
                    end_month: document.getElementById('endMonth').value.substring(0, 7)
                };

                let response;
                if (state.mode === 'demo') {
                    response = await fetch('/api/demo-simulate', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });
                } else {
                    if (!state.uploadedFile) {
                        alert('Upload a CSV file first');
                        throw new Error('No CSV file');
                    }
                    payload.csv_filename = state.uploadedFile;
                    response = await fetch('/api/simulate', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });
                }

                const data = await response.json();

                if (data.success) {
                    state.results = data;
                    displayResults(data);
                    document.getElementById('resultsCard').classList.add('show');
                    document.getElementById('metricsSection').style.display = 'block';
                } else {
                    alert('Error: ' + data.error);
                }
            } catch (error) {
                alert('Simulation error: ' + error.message);
                console.error(error);
            } finally {
                btn.disabled = false;
                btn.innerHTML = '⚡ Run Simulation';
            }
        }

        function displayResults(data) {
            // Ranking
            let rankingHTML = '<div class="ranking">';
            data.results.slice(0, 3).forEach((result, idx) => {
                const rank = idx + 1;
                const savings = result.savings_vs_reference_eur || 0;
                rankingHTML += `
                    <div class="rank-item rank-${rank}">
                        <div class="rank-number">#${rank}</div>
                        <h3>${result.supplier}</h3>
                        <p><strong>${result.plan_name}</strong></p>
                        <div class="cost">€${result.total_cost_eur.toFixed(2)}/year</div>
                        <p>Consumption: ${result.total_consumption_kwh.toFixed(0)} kWh</p>
                        ${savings > 0 ? `<div class="savings">💰 Savings: €${savings.toFixed(2)}</div>` : ''}
                    </div>
                `;
            });
            rankingHTML += '</div>';
            document.getElementById('rankingContent').innerHTML = rankingHTML;

            // Analysis
            const report = data.report;
            let analysisHTML = '';

            if (report.assumptions) {
                analysisHTML += `
                    <h3>📋 Assumptions</h3>
                    <div style="background: var(--gray-50); padding: 15px; border-radius: 8px; margin: 15px 0;">
                        <p><strong>Period:</strong> ${report.assumptions.period}</p>
                        <p><strong>Consumption:</strong> ${report.assumptions.total_consumption_kwh} kWh</p>
                        <p><strong>Current tariff:</strong> ${report.assumptions.reference_tariff}</p>
                        <p><strong>Current cost:</strong> €${report.assumptions.reference_cost_eur.toFixed(2)}</p>
                    </div>
                `;
            }

            if (report.risks && report.risks.length > 0) {
                analysisHTML += '<div class="risks"><h3>⚠️ Identified Risks</h3>';
                report.risks.forEach(risk => {
                    analysisHTML += `<div class="risk-item">${risk.risks.map(r => r.description).join('<br>')}</div>`;
                });
                analysisHTML += '</div>';
            }

            if (report.recommendations && report.recommendations.length > 0) {
                analysisHTML += '<div class="recommendations"><h3>💡 Recommendations</h3>';
                report.recommendations.forEach(rec => {
                    analysisHTML += `<div class="rec-item">${rec}</div>`;
                });
                analysisHTML += '</div>';
            }

            document.getElementById('analysisContent').innerHTML = analysisHTML;

            // Details
            let detailsHTML = '<h3>📊 Technical Details</h3>';
            detailsHTML += `<pre style="background: var(--gray-100); padding: 15px; border-radius: 8px; overflow-x: auto; font-size: 0.85em;">`;
            detailsHTML += JSON.stringify(data.results.slice(0, 2), null, 2);
            detailsHTML += `</pre>`;
            document.getElementById('detailsContent').innerHTML = detailsHTML;

            // Metrics
            if (data.results.length > 0) {
                const best = data.results[0];
                const reference = data.results[data.results.length - 1];
                const savings = (reference.total_cost_eur - best.total_cost_eur);

                document.getElementById('metricConsumption').textContent = best.total_consumption_kwh.toFixed(0);
                document.getElementById('metricMonths').textContent = best.months;
                document.getElementById('metricBestCost').textContent = best.total_cost_eur.toFixed(2);
                document.getElementById('metricSavings').textContent = savings.toFixed(2);
            }
        }

        function switchTab(tabName) {
            document.querySelectorAll('.tab-content').forEach(tab => {
                tab.classList.remove('active');
            });
            document.querySelectorAll('.tab-button').forEach(btn => {
                btn.classList.remove('active');
            });

            document.getElementById(tabName + 'Tab').classList.add('active');
            document.querySelector(`[data-tab="${tabName}"]`).classList.add('active');
        }

        function reset() {
            location.reload();
        }

        function showError(message, elementId) {
            const element = document.getElementById(elementId);
            if (element) {
                element.innerHTML = `<div class="status error">${message}</div>`;
            }
        }
    </script>
</body>
</html>
